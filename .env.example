# Copy this file to .env (in this folder) and replace the placeholder with your own key.
# Never commit .env. It is listed in .gitignore.
# All agents call gpt-6-luna through Portkey (https://api.portkey.ai/v1).
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional: point the app at other files (used by the tests for scratch copies).
# CAMPUS_DB_PATH=data/campus_customs_new.db
# CAMPUS_ORIGINAL_DB_PATH=data/campus_customs.db
